---
import { Font } from 'astro:assets';
import '../styles/global.css';
import CookieConsent from '../components/site/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'EdTrek Digital — Websites for educational travel companies',
  description = 'Lightning-fast, conversion-focused websites for educational travel companies. Built by Kirk Pettinga.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Lock cascade layer order before any stylesheet loads. Component <style>
         blocks use @layer components so Tailwind utilities can override them. -->
    <style is:inline>@layer theme, base, components, utilities;</style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#36464a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-zilla-slab" preload={[{ weight: 300, style: "normal" }, { weight: 700, style: "normal" }]} />
    <Font cssVariable="--font-karla" preload />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:px-4 focus:py-3 type-label"
    >
      Skip to content
    </a>
    <slot name="backdrop" />
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <CookieConsent />
  </body>
</html>
