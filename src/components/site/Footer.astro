---
/**
 * Footer CTA (Figma 70:389 desktop / 113:1570 tablet / 119:1123 mobile).
 *
 * Bedrock band. The page-wide TopoMap supplies the topo texture (it blends to
 * light lines over Bedrock), so there's no separate texture layer here.
 *   Invitation — white Stop marker (solid square), H1 in two sentences, Mist
 *   body, primary CTA.
 *   Bottom bar — 1px rule; Fire trail marker + wordmark, ©, Privacy Policy and
 *   Back to top. One row from tablet up; stacked, left-aligned on mobile.
 * The page trail ends at the Stop square: when it arrives, the square pulses
 * once (swells to 130% and gives off a square ring), like a softer X stamp.
 * A soft 26px shadow along the top edge (Figma's "Top shadow line") seats the
 * band under the section above.
 */
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import ContactModal from './ContactModal.astro';
---

<footer class="footer bg-bedrock text-mist" aria-labelledby="footer-title" data-trail-section>
  <div class="footer-invite container-site above-map section-pad">
    <span class="footer-stop" aria-hidden="true" data-trail-stop></span>
    <h2 id="footer-title" class="type-h1 text-paper footer-title">
      <span>Your trips open up the world.</span>
      <span>Let’s build a website to match.</span>
    </h2>
    <p class="type-body footer-body">
      Bring your ideas, your challenges and your questions. Let’s talk about what’s next for your student travel
      business.
    </p>
    <Button data-modal-open="contact-modal" aria-haspopup="dialog" icon="rocket" class="footer-cta">Let’s Build Your Site</Button>
  </div>

  <div class="footer-bar">
    <div class="footer-bar-inner container-site above-map type-caption">
      <div class="footer-brand text-paper">
        <span class="footer-trail" aria-hidden="true"></span>
        <Logo size={29} />
      </div>
      <p>© 2026 by Kirk Pettinga</p>
      <ul class="footer-links" role="list">
        <li><a href="/privacy" class="footer-link">Privacy Policy</a></li>
        <li><a href="#top" class="footer-link text-paper">Back to top ↑</a></li>
      </ul>
    </div>
  </div>
</footer>

<!-- Outside <footer> so it doesn't inherit the band's Mist text colour. -->
<ContactModal />

<style>
  @reference "../../styles/global.css";

  @layer components {
    .footer {
      position: relative;
      --trail-done: var(--color-mist);
      --trail-ahead: rgb(198 207 204 / 0.22);
      --trail-mark: #fff;

      /* Top shadow line: black 13% → 0 over 26px */
      &::before {
        content: '';
        position: absolute;
        inset: 0 0 auto;
        z-index: 3;
        height: 26px;
        background: linear-gradient(rgb(0 0 0 / 0.13), transparent);
        pointer-events: none;
      }
    }

    .footer-invite {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
      text-align: center;
    }
    /* Stop square pulse (data-stamped set by scripts/trail.ts) */
    .footer-stop {
      position: relative;
      display: block;
      width: 12px; /* = the page trail's start squares */
      height: 12px;
      background: #fff;

      &::after {
        content: '';
        position: absolute;
        inset: 0;
        border: 1.5px solid #fff;
        opacity: 0;
        pointer-events: none;
      }
    }
    .footer-stop[data-stamped='play'] {
      animation: stop-pop 360ms both;
      &::after {
        animation: stop-ring 650ms 80ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
      }
    }
    @keyframes stop-pop {
      0% {
        scale: 1;
        animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1);
      }
      40% {
        scale: 1.3;
        animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      }
      100% {
        scale: 1;
      }
    }
    @keyframes stop-ring {
      from {
        opacity: 0.9;
        scale: 1;
      }
      to {
        opacity: 0;
        scale: 2.8;
      }
    }

    .footer-title > span {
      display: block;
    }
    .footer-body {
      max-width: 630px;
    }
    :global(.footer-cta) {
      margin-top: 16px; /* invitation → CTA = 40 */
    }

    .footer-bar {
      position: relative;
      border-top: 1px solid color-mix(in srgb, var(--color-mist) 30%, var(--color-bedrock)); /* ≈ #617074 */
    }
    .footer-bar-inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding-block: 32px;

      @variant tablet {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding-block: 36px;
      }
    }
    .footer-brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .footer-trail {
      width: 9px;
      height: 9px;
      background: var(--color-fire);
    }
    .footer-links {
      display: flex;
      gap: 30px;
    }
    .footer-link {
      text-decoration: underline;
      text-decoration-color: transparent;
      text-underline-offset: 0.2em;
      transition: text-decoration-color 200ms var(--ease-brand);

      &:hover {
        text-decoration-color: currentColor;
      }
      &:focus-visible {
        outline: 2px solid var(--color-paper);
        outline-offset: 4px;
      }
    }
  }
</style>
