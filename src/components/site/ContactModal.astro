---
/**
 * ContactModal — the "Let's Build Your Site" popup: a single email field.
 * Opened by any [data-modal-open="contact-modal"]: every primary CTA
 * (Let’s Build Your Site, nav Book a Call).
 *
 * The form is hosted separately (no server code in this repo): set
 * FORM_ACTION to the provider's POST endpoint. Until it's set, submitting is
 * blocked so nothing gets sent to this static site.
 */
import Modal from '../ui/Modal.astro';
import Button from '../ui/Button.astro';

// TODO: external form endpoint (e.g. Formspree / Basin / Tally URL).
const FORM_ACTION = '';
---

<Modal id="contact-modal" eyebrow="Step 1" title="Provide your email address to get started.">
    <iframe
        src="https://links.edtrek.digital/widget/form/kOqWoXaDnEsULzWsOKJb"
        style="width:100%;height:100%;border:none;border-radius:0px"
        id="inline-kOqWoXaDnEsULzWsOKJb"
        data-layout="{'id':'INLINE','formWidth':500}"
        data-trigger-type="alwaysShow"
        data-trigger-value=""
        data-activation-type="alwaysActivated"
        data-activation-value=""
        data-deactivation-type="neverDeactivate"
        data-deactivation-value=""
        data-form-name="A-101-2. Application Step 1 "
        data-height="400"
        data-layout-iframe-id="inline-kOqWoXaDnEsULzWsOKJb"
        data-form-id="kOqWoXaDnEsULzWsOKJb"
        data-cookie-consent="true"
        data-cookie-consent-provider="auto"
        title="A-101-2. Application Step 1 "
        >
    </iframe>
    <script src="https://links.edtrek.digital/js/form_embed.js"></script>
</Modal>

