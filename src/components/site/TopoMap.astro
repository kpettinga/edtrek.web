---
/**
 * TopoMap — the one topo map that runs behind the whole page.
 *
 * Lines only: the texture is white contour lines on transparent
 * (assets/textures/topo.svg, generated by scripts/generate-topo.mjs — run
 * `npm run topo`; preview seeds at /topo in dev), drawn with
 * `mix-blend-mode: difference`. Over white they read as soft grey lines, over
 * Bedrock as light lines, over Air as darker lines — so one map carries across
 * every section colour with crisp section edges.
 *
 * Motion:
 *   - scroll: the map drifts up (--map-y) and zooms slightly across the hero
 *     (--map-scale), set by scroll-scene.ts
 *   - pointer (mouse/pen only): a soft spotlight reveals the map at full
 *     strength around the cursor (--mx/--my/--reveal-r, set by topo-reveal.ts);
 *     elsewhere it stays faint
 *   - touch / no hover: a faint static map, no reveal
 *
 * Layering (see `veil` / `above-map` in global.css):
 *   section backgrounds  <  map (z 1)  <  white-section veils (z 2)  <  content (z 3)
 * The map is fixed at z-index 1 and must be the blending element itself:
 * position:fixed always forms a stacking context, which would isolate a blend
 * nested inside it from the sections beneath.
 * The SVG is used as an image source, not inline, so it's rasterized once and
 * only composited on scroll. It wraps top ↔ bottom, so tiles stack seamlessly.
 */
import topoUrl from '../../assets/textures/topo.svg?url';

const TILES = 4; // ≥ viewport height + max vertical travel at every breakpoint
---

<div class="topo" style={`--topo-src: url(${topoUrl})`} aria-hidden="true" data-topo-reveal>
    <div class="topo-tiles">
        {Array.from({ length: TILES }, () => <div class="topo-tile" />)}
    </div>
</div>

<style>
    @reference "../../styles/global.css";

    @layer components {
        .topo {
            /* Rendered width of one tile (Figma: 2045px frame on mobile/tablet, ~1500px at 1440 desktop) */
            --topo-width: 2130px;
            --topo-peak: 0.26; /* line strength under the pointer */
            --topo-base: 0.28; /* fraction of peak shown everywhere else */
            position: fixed;
            inset: 0;
            z-index: 1;
            overflow: hidden;
            pointer-events: none;
            mix-blend-mode: difference;
            opacity: var(--topo-peak);
            mask-image: radial-gradient(
                circle var(--reveal-r, 0px) at var(--mx, 50%) var(--my, 50%),
                #000 0%,
                rgb(0 0 0 / 0.6) 45%,
                rgb(0 0 0 / var(--topo-base)) 100%
            );

            @variant desktop {
                --topo-width: max(1500px, 104.2vw);
            }
            /* Touch / no hover: faint static map */
            @media not ((hover: hover) and (pointer: fine)) {
                mask-image: none;
                opacity: calc(var(--topo-peak) * var(--topo-base));
            }
        }

        .topo-tiles {
            position: absolute;
            top: 0;
            left: 50%;
            width: var(--topo-width);
            margin-left: calc(var(--topo-width) / -2);
            transform-origin: 50% 50vh; /* zoom about the viewport center */
            transform: translate3d(0, var(--map-y, 0px), 0) scale(var(--map-scale, 1));
            will-change: transform;
        }
        .topo-tile {
            aspect-ratio: 3 / 2;
            background: var(--topo-src) center / 100% 100% no-repeat;
        }
    }
</style>
