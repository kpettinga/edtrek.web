---
/**
 * Icon — 24×24 grid, round caps/joins, currentColor.
 * Stroke renders at 2px at every display size (handoff §6).
 * Base set: Tabler Icons (MIT). Custom icons drawn to the same grid.
 */
import { iconBody, type IconName } from './icons';
export type { IconName } from './icons';
export { iconNames } from './icons';

interface Props {
  name: IconName;
  /** Display size in px: 16 (small btn), 20 (btn, callouts), 24 (inline), 32 (cards), 48 (section markers, 404 graphic). */
  size?: 16 | 20 | 24 | 32 | 48;
  /** Accessible label. Omit for decorative icons (default). */
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
const body = iconBody(name);
// Keep a 2px on-screen stroke regardless of display size.
const strokeWidth = +(48 / size).toFixed(3);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
