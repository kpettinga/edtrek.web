---
/**
 * Three yeses (Figma 49:773 desktop / 113:1330 tablet / 119:877 mobile).
 *
 * Desktop: 3 audience tiles in a row (equal height). Hover: lift 4px, Bedrock
 *          border, Tile shadow, eyebrow, icon + bullets turn Fire.
 * Tablet:  tiles full-width with two columns — intro | "What they look for",
 *          split by an Air divider, both top-aligned.
 * Mobile:  single column; "What they look for" is a drawer (<button
 *          aria-expanded>, chevron rotates 180°), closed by default. Without JS
 *          the lists simply show.
 */
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Waypoint from '../ui/Waypoint.astro';

const audiences = [
    {
        key: 'educators',
        eyebrow: 'The deciding yes',
        title: 'Educators',
        icon: 'school',
        text: 'Choose whether their school goes, and need to justify the trip to administrators.',
        wants: ['Itineraries tied to learning goals', 'Clear safety and supervision policies', 'An easy way to request a proposal'],
    },
    {
        key: 'parents',
        eyebrow: 'The trusting yes',
        title: 'Parents',
        icon: 'heart',
        text: 'Need to feel confident their child will be safe, supported, and that the trip is worth the cost.',
        wants: ['Transparent pricing and payment options', 'Safety, insurance, and emergency info', 'Straight answers to common questions'],
    },
    {
        key: 'students',
        eyebrow: 'The excited yes',
        title: 'Students',
        icon: 'mood-excited',
        text: 'Want to know what they’ll see, do, and remember — and to start looking forward to it.',
        wants: ['Destination photos and stories', 'Highlights from past trips', 'What to expect and what to pack'],
    },
] as const;
---

<section id="three-yeses" class="yeses veil section-pad" aria-labelledby="yeses-title" data-yeses data-trail-section>
    <div class="yeses-inner container-site above-map" data-trail-end>
        <Waypoint />
        <h2 id="yeses-title" class="type-h2 yeses-title">
            Every trip needs <strong class="font-bold">three people</strong> to say <span class="text-fire"
                >“<em>yes</em>”</span
            >
        </h2>
        <p class="type-body yeses-intro">
            Educators decide where their students go. Parents need to feel confident sending them. Students need to be excited
            to go. Your website should speak to all three.
        </p>

        <ul class="yeses-cards" role="list">
            {
                audiences.map((a) => (
                    <li class="aud">
                        <div class="aud-intro">
                            <p class="type-eyebrow aud-eyebrow">{a.eyebrow}</p>
                            <div class="aud-heading">
                                <h3 class="type-h3">{a.title}</h3>
                                <Icon name={a.icon} size={32} class="aud-icon" />
                            </div>
                            <p class="type-body aud-text">{a.text}</p>
                        </div>

                        <div class="aud-wants">
                            <p class="type-eyebrow aud-wants-label">What they look for</p>
                            <button
                                type="button"
                                class="type-eyebrow aud-toggle"
                                aria-expanded="false"
                                aria-controls={`wants-${a.key}`}
                            >
                                What they look for
                                <Icon name="chevron-down" size={16} class="aud-chevron" />
                            </button>
                            <div class="aud-panel" id={`wants-${a.key}`}>
                                <div class="aud-panel-inner">
                                    <ul class="aud-list" role="list">
                                        {a.wants.map((w) => (
                                            <li class="type-body-sm">{w}</li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </li>
                ))
            }
        </ul>

        <div class="yeses-cta">
            <p class="type-body-sm">Every audience is different — I’ll help you decide what matters most for yours.</p>
        </div>
    </div>
</section>

<script>
    // Mobile drawers. The toggle buttons are only displayed on mobile (CSS), so
    // this wiring is harmless at larger sizes; data-drawers switches on the
    // closed-by-default styling only once JS is running.
    const root = document.querySelector<HTMLElement>('[data-yeses]');
    if (root) {
        root.dataset.drawers = '';
        root.querySelectorAll<HTMLButtonElement>('.aud-toggle').forEach((btn) => {
            btn.addEventListener('click', () => {
                const open = btn.getAttribute('aria-expanded') !== 'true';
                btn.setAttribute('aria-expanded', String(open));
            });
        });
    }
</script>

<style>
    @reference "../../styles/global.css";

    @layer components {
        .yeses {
            position: relative;
            overflow-x: clip;
            /* The hero above has no veil: fade ours in across the top padding so the
               map strength changes gradually instead of at a hard edge. */
            --veil-fade: var(--section-padding-block);
        }
        .yeses-inner {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
            text-align: center;
        }
        .yeses-title {
            max-width: 820px;
            text-wrap: balance;
        }
        .yeses-intro {
            max-width: 660px;
        }

        /* ---- cards ---- */
        .yeses-cards {
            display: flex;
            flex-direction: column;
            gap: 20px;
            width: 100%;
            padding-block: 29px;
            text-align: left;

            @variant tablet {
                gap: 24px;
            }
            @variant desktop {
                flex-direction: row;
                gap: 40px;
            }
        }
        .aud {
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding: 28px 24px;
            background: #fff;
            border: 1px solid var(--color-card-border);

            @variant tablet {
                flex-direction: row;
                gap: 0;
                padding: 40px 36px;
            }
            @variant desktop {
                flex: 1 1 0;
                flex-direction: column;
                gap: 24px; /* 16 + Figma's 8px spacer */
                transition:
                    translate 220ms var(--ease-brand),
                    border-color 220ms var(--ease-brand),
                    box-shadow 220ms var(--ease-brand);
            }
        }
        .aud-intro {
            display: flex;
            flex-direction: column;
            gap: 8px;

            @variant tablet {
                flex: 1 1 0;
                padding-right: 32px;
            }
        }
        :global(.aud-icon) {
            color: var(--color-lagoon);
            transition: color 220ms var(--ease-brand);
        }
        .aud-eyebrow {
            color: var(--color-lagoon);
            transition: color 220ms var(--ease-brand);
        }
        .aud-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }
        .aud-text {
            margin-top: 8px; /* header → text = 16 */
        }

        /* ---- "What they look for" ---- */
        .aud-wants {
            display: flex;
            flex-direction: column;

            @variant tablet {
                flex: 1 1 0;
                padding-left: 32px;
                border-left: 1px solid var(--color-air);
            }
            @variant desktop {
                flex: none;
                padding: 20px 0 0;
                border-left: 0;
                border-top: 1px solid var(--color-air);
            }
        }
        .aud-wants-label,
        .aud-toggle {
            color: var(--color-lagoon);
        }
        .aud-toggle {
            display: none;
            align-items: center;
            gap: 6px;
            align-self: flex-start;
            cursor: pointer;
        }
        :global(.aud-chevron) {
            transition: rotate 220ms var(--ease-brand);
        }
        .aud-toggle[aria-expanded='true'] :global(.aud-chevron) {
            rotate: 180deg;
        }
        .aud-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding-top: 12px;

            & li {
                position: relative;
                padding-left: 17px;

                /* 5px square bullet, centred on the first line (1.3 × 16 ≈ 21px) */
                &::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 8px;
                    width: 5px;
                    height: 5px;
                    background: var(--color-lagoon);
                    transition: background-color 220ms var(--ease-brand);
                }
            }
        }

        /* Mobile drawer: once JS is running, swap the label for the toggle and
           collapse the panel until opened. */
        [data-drawers] .aud-wants-label {
            @variant max-tablet {
                display: none;
            }
        }
        [data-drawers] .aud-toggle {
            @variant max-tablet {
                display: inline-flex;
            }
        }
        [data-drawers] .aud-panel {
            @variant max-tablet {
                display: grid;
                grid-template-rows: 0fr;
                visibility: hidden;
                transition:
                    grid-template-rows 260ms var(--ease-brand),
                    visibility 0s 260ms;

                & > .aud-panel-inner {
                    min-height: 0;
                    overflow: hidden;
                }
            }
        }
        [data-drawers] .aud-toggle[aria-expanded='true'] + .aud-panel {
            @variant max-tablet {
                grid-template-rows: 1fr;
                visibility: visible;
                transition: grid-template-rows 260ms var(--ease-brand);
            }
        }

        /* Desktop hover (tiles aren't links, so this is a light acknowledgement) */
        @media (hover: hover) {
            .aud:hover {
                @variant desktop {
                    translate: 0 -4px;
                    border-color: var(--color-bedrock);
                    box-shadow: var(--shadow-tile);

                    & .aud-eyebrow {
                        color: var(--color-fire);
                    }
                    & .aud-list li::before {
                        background: var(--color-fire);
                    }
                }
            }
        }
        @media (hover: hover) {
            /* separate rule: Astro doesn't rewrite :global() nested under & */
            .aud:hover :global(.aud-icon) {
                @variant desktop {
                    color: var(--color-fire);
                }
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .aud,
            :global(.aud-chevron),
            :global(.aud-icon),
            .aud-eyebrow,
            .aud-panel {
                transition: none !important;
            }
        }

        /* ---- closing line + CTA ---- */
        .yeses-cta {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
            margin-top: 16px;

            @variant desktop {
                flex-direction: row;
            }
        }
    }
</style>
